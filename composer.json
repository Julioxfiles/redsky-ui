{
  "name": "redsky/ui",
  "description": "The PHP user interface for redsky/mvc-api",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.6"    
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Support/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": [
      "app/Support/Helpers/dev_helpers.php"
    ]
  }
  
  
}