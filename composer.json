{
  "name": "redsky/ui",
  "description": "Interface de Usuario (UI) para usar la API REST skynet-api",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.6",
    "skynet/core": "*@dev"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,

  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Support/Helpers/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": [
      "app/Support/Helpers/dev_helpers.php"
    ]
  }
  
}