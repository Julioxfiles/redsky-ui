{
  "name": "redsky/ui",
  "description": "The PHP user interface for redsky framework ecosystem",
  "type": "project",
  "license": "proprietary",

  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.6",
    "redsky/bootstrap": "dev-main",
    "redsky/view": "dev-main"
  },

  "repositories": [
    {
      "type": "path",
      "url": "../redsky-framework",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../redsky-bootstrap",
      "options": {
        "symlink": true
      }
    },
    {
        "type": "path",
        "url": "../redsky-view",
        "options": {
            "symlink": true
        }
    }
  ],

  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },

  "minimum-stability": "dev",
  "prefer-stable": true
}
